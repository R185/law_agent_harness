+        )
+
+    if config.ENABLE_TONE:
+        for violation in style.audit_hard(text):
+            problems.append(f"{violation.hint} (фрагмент: «{violation.quote}»)")
+
+    return problems
+
+
+def normalize_answer(raw: str) -> str:
+    """Apply the deterministic part of tone control: artifacts out, one line left."""
