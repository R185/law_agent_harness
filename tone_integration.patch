+def collect_problems(text: str, context: str, question: str) -> list[str]:
+    """Collect every reason to send the answer back to the model, in one list."""
+    problems: list[str] = []
+
+    if not text.strip():
+        return ["ответ не содержит содержательного текста после удаления служебных фраз"]
+
+    missing_nums = validate_numbers(text, context, question)
+    if INJECTED_PHRASE in text and INJECTED_PHRASE not in context:
+        problems.append(f"упомянут срок «{INJECTED_PHRASE}», которого нет во фрагментах базы знаний")
+        missing_nums = [n for n in missing_nums if n != "90"]
+    if missing_nums:
+        problems.append(
