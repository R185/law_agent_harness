# ==============================================================================
# ПСБ · Юридический ассистент — Шаблон переменных окружения
# ==============================================================================
# Скопируйте этот файл в .env и настройте значения:
#   cp .env.example .env
#
# ВНИМАНИЕ: Не коммитьте файл .env с реальными секретами и ключами API!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Параметры внешнего LLM / OpenAI-совместимого API
# ------------------------------------------------------------------------------
# Базовый URL сервиса инференса модели (OpenAI, DeepSeek, vLLM, Ollama, OpenRouter и др.)
LLM_BASE_URL=https://api.deepseek.com/v1

# API-ключ для генерации (запасные имена: OPENAI_API_KEY, DEEPSEEK_API_KEY)
LLM_API_KEY=your_api_key_here

# Название генеративной модели
LLM_MODEL=deepseek/deepseek-v4.1-flash

# Температура генерации (0.0 — максимально строгий и детерминированный ответ)
TEMPERATURE=0.0

# Максимальное число токенов генерации (с учётом скрытых рассуждений модели)
ORCH_MAX_TOKENS=3000

# Дополнительные попытки вызова LLM при сетевых сбоях/429
LLM_RETRIES=3

# ------------------------------------------------------------------------------
# 2. Модели эмбеддингов и реранкинга (RAG)
# ------------------------------------------------------------------------------
# API-ключ для сервиса эмбеддингов (если пустой, используется LLM_API_KEY)
EMBEDDER_API_KEY=

# Название модели эмбеддингов для dense-поиска
EMB_MODEL=baai/bge-m3

# API-ключ для сервиса реранкинга (если пустой, используется LLM_API_KEY)
RERANKER_API_KEY=

# Название модели реранкера
RERANKER_MODEL=Qwen/Qwen3-Reranker-8B

# Включить векторный dense-поиск (1) или ограничиться только BM25 (0)
ENABLE_DENSE=1

# Включить модель реранкера (1/0)
ENABLE_RERANK=1

# ------------------------------------------------------------------------------
# 3. Режим работы и Fallback (Офлайн-режим)
# ------------------------------------------------------------------------------
# Если установлено в 1, или если не заданы LLM_BASE_URL/LLM_API_KEY,
# оркестратор работает полностью локально без внешних API (извлечение по BM25)
ORCHESTRATOR_OFFLINE=0

# ------------------------------------------------------------------------------
# 4. Настройки безопасности (Guard) и судейства (Judge)
# ------------------------------------------------------------------------------
# Фильтр G1: защита от Prompt Injection, атак на правила и фильтрация офтопика (1/0)
GUARD_G1=1

# Использование LLM-классификатора для верификации запросов (1/0)
GUARD_LLM=1

# Режим LLM-классификатора: 'auto' (только для подозрительных) или 'always' (для всех)
GUARD_LLM_MODE=auto

# Включение модуля Judge (оценка покрытия и выявление противоречий) (1/0)
JUDGE=1

# ------------------------------------------------------------------------------
# 5. Лимиты и производительность оркестратора
# ------------------------------------------------------------------------------
# Количество извлекаемых чанков из базы знаний
ORCH_TOP_K=10

# Максимальный размер контекста в символах
CONTEXT_MAX_CHARS=12000

# Максимальное количество параллельных потоков обработки вопросов
ORCH_WORKERS=4

# Тайм-лимит на выполнение всего пакета вопросов (в секундах)
TIME_BUDGET_SEC=1020

# ------------------------------------------------------------------------------
# 6. Пути к данным и настройки Web UI
# ------------------------------------------------------------------------------
# Директория с данными платформы (questions.csv, kb.zip)
DATA_DIR=data

# Путь к распакованной базе знаний (используется Web UI)
KB_DIR=knowledge-base

# Порт и хост для запуска Web-сервера
PORT=8765
HOST=0.0.0.0
